# Default: Sarvam-105B (Indian-language model, OpenAI-compatible API). Sign up: dashboard.sarvam.ai
SARVAM_API_KEY=
# Swap the model with these three values - no code change. Examples:
#   LLM_PROVIDER=openai     OPENAI_API_KEY=...      (LLM_MODEL defaults to gpt-6-luna)
#   LLM_PROVIDER=gemini     GEMINI_API_KEY=...      (gemini-3.5-flash-lite, free tier)
#   LLM_PROVIDER=anthropic  ANTHROPIC_API_KEY=...   (claude-haiku-5-5)
#   LLM_PROVIDER=custom     LLM_BASE_URL=https://... LLM_API_KEY=... LLM_MODEL=...
LLM_PROVIDER=sarvam
# LLM_MODEL=
# Sarvam thinking mode: off (default, fast) | low | medium | high
LLM_REASONING=off
MAX_CALLS_PER_SESSION=40
